{
  "name": "@dlabz/jsdoc-dts-rag",
  "version": "1.0.0",
  "description": "Continuous JSDoc to .d.ts + Markdown compilation pipeline with AST graph extraction and live RAG vector store synchronization",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rag-sync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "rules",
    ".agents",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsx src/cli.ts build",
    "watch": "tsx src/cli.ts watch",
    "query": "tsx src/cli.ts query",
    "rag": "tsx src/cli.ts repl",
    "test": "tsx test/pipeline.test.ts",
    "build:package": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlabz/jsdoc-dts-rag.git"
  },
  "keywords": [
    "jsdoc",
    "typescript",
    "dts",
    "markdown",
    "ast-graph",
    "rag",
    "vector-search",
    "chokidar",
    "ai-context-efficiency"
  ],
  "author": "dlabz",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3"
  }
}
